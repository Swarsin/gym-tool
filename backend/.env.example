# Supabase Postgres Connection String (Asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# Google Gemini API Key for AI Coaching Feedback
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Project Credentials
SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="workout-videos"
R2_PUBLIC_URL="https://pub-[YOUR-BUCKET-ID].r2.dev"

# CORS Origin for Frontend
FRONTEND_URL="http://localhost:5173"

# Pose extraction: 0=Lite, 1=Full, 2=Heavy. Benchmark before reducing cadence.
MEDIAPIPE_MODEL_COMPLEXITY=1
MEDIAPIPE_TARGET_FPS=30
# Optional: benchmark on the production CPU quota before overriding OpenCV's pool.
# OPENCV_NUM_THREADS=1
